@model Guid
@{ ViewData["Title"] = "Mua vé"; }
@section Head { <link rel="stylesheet" href="~/css/event-detail.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/seatpicker.css" asp-append-version="true" /> }
<div class="wrap evd-wrap">
  <div id="app" class="evd" data-event-id="@Model">
    <div class="skel" style="height:90px"></div>
    <div class="evd-body">
      <div class="evd-main"><div class="skel" style="height:420px"></div></div>
      <div class="skel" style="height:320px"></div>
    </div>
  </div>
</div>
@section Scripts { <script src="~/js/seatpicker.js" asp-append-version="true"></script><script src="~/js/book.js" asp-append-version="true"></script> }
