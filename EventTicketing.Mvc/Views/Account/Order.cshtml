@model Guid
@{ ViewData["Title"] = "Đơn hàng"; }
@section Head { <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" /> }
<div class="ck-page">
  <div class="wrap">
    <div id="app" class="ck" data-mode="order" data-id="@Model"><div class="skel ck-skel" style="height:300px"></div></div>
  </div>
</div>
<dialog id="qrDialog" class="qr-modal" aria-label="Mã QR phóng to">
  <img id="qrBig" alt="Mã QR của vé" />
  <button class="btn btn-ink btn-block" type="button" id="qrClose">Đóng</button>
</dialog>
@section Scripts { <script src="~/js/ticket-view.js" asp-append-version="true"></script> }
