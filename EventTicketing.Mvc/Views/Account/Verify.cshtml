@{ ViewData["Title"] = "Xác thực email"; ViewData["Auth"] = true; }
<div class="auth">
  <partial name="_AuthArt" />
  <div class="auth-form">
    <div class="auth-top">
      <a class="brand auth-brand" href="/" aria-label="TicketGo"><img src="/img/logo-wordmark.png" alt="TicketGo" width="210" height="46" /></a>
      <a class="auth-back" href="/">&larr; Về trang chủ</a>
      <span>Sai email? <a href="/Account/Register">Đăng ký lại</a></span>
    </div>
    <form id="f" class="auth-card" data-mode="verify" novalidate>
      <ol class="auth-steps" aria-label="Các bước đăng ký">
        <li class="done">Tạo tài khoản</li>
        <li aria-current="step">Xác thực email</li>
      </ol>
      <h1>Nhập mã xác thực</h1>
      <p class="muted">Mã 6 số vừa được gửi tới email của bạn và có hiệu lực trong 5 phút.</p>
      <p class="form-err" id="formErr" role="alert"></p>

      <div class="field" data-field="email">
        <label for="email">Email</label>
        <div class="ctl"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
          <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-err" /></div>
        <small class="err" id="email-err" role="alert"></small>
      </div>
      <div class="field"><label id="otpLabel">Mã OTP</label><div class="otp" id="otp" role="group" aria-labelledby="otpLabel"></div></div>
      <button class="btn btn-primary btn-block" type="submit">Xác thực</button>
      <button class="btn btn-ghost btn-block" type="button" id="resend">Gửi lại mã</button>
    </form>
  </div>
</div>
@section Scripts { <script src="~/js/auth.js" asp-append-version="true"></script> }
