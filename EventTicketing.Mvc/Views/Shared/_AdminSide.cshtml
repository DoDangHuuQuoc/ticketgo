<aside class="adm-side" aria-label="Quản trị hệ thống">
  <p class="adm-side-t">Quản trị hệ thống</p>
  <nav id="admTabs">
    @foreach (var grp in items.GroupBy(i => i.Group))
    {
      <div class="adm-grp" data-staff="@(grp.Any(i => i.Staff) ? "1" : null)">
        <span class="adm-grp-t">@grp.Key</span>
        @foreach (var t in grp)
        {
          <a href="@t.Href" data-staff="@(t.Staff ? "1" : null)" aria-current="@(t.Key == active ? "page" : null)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@t.Icon"/></svg>
            <span>@t.Label</span>
          </a>
        }
      </div>
    }
  </nav>
</aside>
